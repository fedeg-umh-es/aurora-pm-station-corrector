# Project-specific: never commit raw data, credentials, or large model files
data/raw/aurora/*.nc
data/raw/aurora/*.grib
data/raw/aurora/*.grib2
data/raw/cams/
credentials/
*.env
.env

# Results: large prediction files stay local; only summary CSVs are committed
results/runs/**/*.pkl
results/runs/**/*.parquet
results/runs/**/*.nc

# Provenance JSON sidecars are committed; large artefacts are not
*.ckpt
*.pt
*.h5

# GVA raw hourly station files (re-fetchable via scripts/p1_00_fetch_gva_hourly.py; SHA-256 in manifest)
data/raw/stations/gva/*.csv
data/interim/gva_tidy/
